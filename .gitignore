# Files and directories created by pub.
.dart_tool/
.packages
build/
pubspec.lock

# Conventional directory for build outputs.
/coverage/

# Directory created by dartdoc.
doc/api/

# Flutter / Dart specific
.flutter-plugins
.flutter-plugins-dependencies
.metadata
.pub-cache/
.pub/

# Token codegen tool — npm deps are restored via `npm --prefix tool ci`
# (package.json + package-lock.json ARE committed; node_modules is not).
tool/node_modules/

# alchemist writes diff artifacts here on every failing golden run. They are
# untracked build output — but `dart pub publish` bundles *everything* under the
# package root except what .gitignore/.pubignore excludes, so without this entry
# a local failing run silently bakes 4 PNGs into the published tarball forever.
# (Since 0.7.0 the off-CI diff threshold absorbs cross-arch AA, so local runs pass.)
test/golden/failures/

# Local tooling artefact: a hook writes one line per tool invocation here.
# Contents are timestamps and tool names only — no arguments, paths or output —
# but it is machine-local noise, and it slipped into a commit once already.
# (pub excludes root dot-directories, so it never reached the published
# archive; this keeps it out of the repository too.)
.claude/logs/

